<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.ziipsan</groupId>
        <artifactId>ziipsan</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ziipsan-mtr</artifactId>
    <name>ZIIPSAN MTR - Manifesto de Transporte de Resíduos</name>

    <dependencies>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- CPF do motorista, documento do gerador e lista de motoristas vão cifrados (E4). -->
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.locationtech.jts</groupId>
            <artifactId>jts-core</artifactId>
        </dependency>
        <dependency>
            <!-- Mapeia Point/Polygon/LineString do JTS para colunas PostGIS. Sem ele, o Hibernate falha
                 com "Could not determine recommended JdbcType for org.locationtech.jts.geom.Point". -->
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-spatial</artifactId>
        </dependency>
        <dependency>
            <!-- ED-104 (sessão 6d762d43-e1a9-4984-b50d-571ba0643b52) — E11/COD-33: biblioteca de PDF
                 (Apache PDFBox) no lugar do escritor byte a byte: fonte embebida (acentuação
                 pt-BR) e saída PDF/A-1b declarada. Versão fixada aqui porque nenhum pom do repo
                 declara biblioteca de PDF. -->
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>