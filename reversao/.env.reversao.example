# ED-04 -- exemplo de .env.reversao (copiar para .env.reversao e preencher).
# NENHUM valor aqui e uma credencial real: todos os segredos sao o
# placeholder "preencher". Credenciais fora do repositorio (P0.27):
# o .env.reversao preenchido NUNCA e versionado.

# Imagem da aplicacao entregue com o pacote (tag fixa, sem latest).
ZIIPSAN_IMAGE=preencher:tag-fixa-da-imagem-entregue

# Segredos (preencher fora do repositorio; sem valor padrao no compose).
POSTGRES_SUPERUSER_PASSWORD=preencher
ZIIPSAN_APP_PASSWORD=preencher
ZIIPSAN_MIGRATOR_PASSWORD=preencher
KEYCLOAK_DB_PASSWORD=preencher
KEYCLOAK_ADMIN_PASSWORD=preencher
MINIO_PASSWORD=preencher
VAULT_TOKEN=preencher

# Portas publicadas (banco e Keycloak sempre so em 127.0.0.1; a api usa
# REVERSAO_API_BIND, com default 127.0.0.1 -- expor a api para a rede do
# orgao e decisao do ensaio, feita aqui, nunca no compose versionado).
REVERSAO_DB_PORT=5432
REVERSAO_KC_PORT=8080
REVERSAO_API_PORT=8090
REVERSAO_API_BIND=127.0.0.1

# Schema do tenant importado (o schema_name de public.tenant_catalog).
REVERSAO_TENANT_SCHEMA=preencher-schema-do-tenant-sintetico

# Opcionais (descomentar so se precisar mudar o default do compose):
# Emissor OIDC que a api valida. Default do compose:
# http://localhost:8080/realms/ziipsan -- se REVERSAO_KC_PORT mudar de
# 8080, ajustar esta variavel para a nova porta, para acompanhar o
# KC_HOSTNAME do Keycloak.
#ZIIPSAN_OIDC_ISSUER=http://localhost:8080/realms/ziipsan
# Provedor de criptografia. Default do compose: dev-env.
#ZIIPSAN_CRYPTO_PROVIDER=dev-env
# Origens CORS da api. Default do compose: http://localhost:3000.
#ZIIPSAN_CORS_ORIGINS=http://localhost:3000

# Caminhos do pacote (descomentar so se o layout nao for o do
# repositorio, com o compose em reversao/ e os diretorios em ../infra/):
#REVERSAO_PG_INIT_DIR=../infra/postgres/init
#REVERSAO_KC_IMPORT_DIR=../infra/keycloak/realms
#REVERSAO_VAULT_CONFIG=../infra/vault/config.hcl
