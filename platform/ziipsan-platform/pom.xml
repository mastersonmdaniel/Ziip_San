<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.ziipsan</groupId>
        <artifactId>ziipsan</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ziipsan-platform</artifactId>
    <name>ZIIPSAN Platform - Multi-tenancy and Module Registry</name>

    <dependencies>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- P0.13: catálogo de permissões recurso:ação (resolução perfil → permissão). -->
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- P2.1: Spring Batch 6 (Boot 4.1) — um Job por rota, JobRepository
                 JDBC nas tabelas BATCH_* da core V10. Licença Apache-2.0. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P0.8: API de tracing (sem bridge: o bridge Brave vive so no modulo app).
             JwtTenantFilter marca tenant_id no span quando ha Tracer no contexto. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <!-- Resource server JWT: o tenant da requisicao vem do token (JwtTenantFilter). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <!-- @Valid/@NotNull no FieldDeviceController (ED-18); mesmo
                 desenho do ziipsan-registry. A entrega da ED-18 trouxe o
                 controller sem esta dependência — correcção
                 correcao-ci-platform-pom (achado nº 7 da CI, 2026-11-09). -->
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 separou os drivers de banco do core. Sem este modulo,
                 Flyway.migrate() falha com "Unsupported Database: PostgreSQL 15". -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <!-- P1.19: leitor WebP (só leitura) para o reencode do logo do tenant
                 (a escrita é PNG pelo ImageIO do JDK; ver o dependencyManagement). -->
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- P0.47 / decisoes 66 + 71 (10/11/2026): o teste de fronteira
             (VerticalBoundaryTest, ArchUnit da P0.3) mudou de casa para o modulo
             ziipsan-app, que ja declara archunit-junit5 e as dependencias de
             fiscal e billing em compile. Com ele sairam daqui as duas
             dependencias de teste que so ele consumia neste modulo (verificado
             por varredura exaustiva em src/main e src/test: nenhum outro
             ficheiro do platform importa com.tngtech.archunit nem
             br.com.ziipsan.commercial.fiscal): a aresta ziipsan-fiscal (test),
             cujo fim desbloqueia o ciclo fiscal -> billing no reactor, e a
             archunit-junit5 (test), orfa apos a mudanca de casa. -->
    </dependencies>
</project>