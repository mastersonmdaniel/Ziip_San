<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.ziipsan</groupId>
        <artifactId>ziipsan</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ziipsan-platform</artifactId>
    <name>ZIIPSAN Platform - Multi-tenancy and Module Registry</name>

    <dependencies>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- P0.13: catálogo de permissões recurso:ação (resolução perfil → permissão). -->
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- P2.1: Spring Batch 6 (Boot 4.1) — um Job por rota, JobRepository
                 JDBC nas tabelas BATCH_* da core V10. Licença Apache-2.0. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P0.8: API de tracing (sem bridge: o bridge Brave vive so no modulo app).
             JwtTenantFilter marca tenant_id no span quando ha Tracer no contexto. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <!-- Resource server JWT: o tenant da requisicao vem do token (JwtTenantFilter). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 separou os drivers de banco do core. Sem este modulo,
                 Flyway.migrate() falha com "Unsupported Database: PostgreSQL 15". -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <!-- P1.19: leitor WebP (só leitura) para o reencode do logo do tenant
                 (a escrita é PNG pelo ImageIO do JDK; ver o dependencyManagement). -->
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- P0.47: teste de fronteira (ArchUnit da P0.3) — o nucleo nao pode depender
                 do pacote fiscal; escopo de teste, sem aresta de producao para o fiscal. -->
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-fiscal</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>