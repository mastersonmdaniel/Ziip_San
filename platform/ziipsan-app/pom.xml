<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.ziipsan</groupId>
        <artifactId>ziipsan</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ziipsan-app</artifactId>
    <name>ZIIPSAN App - Composicao dos modulos e testes de integracao</name>
    <description>
        Reune todos os modulos no mesmo classpath. E o unico lugar onde da para provar que as
        migrations, as entidades JPA e o provisionamento de tenant funcionam juntos: cada modulo
        sozinho passa no build sem enxergar os outros.
    </description>

    <dependencies>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-quality</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-losses</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-gis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-mtr</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-lgpd</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-registry</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-billing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-metering</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-collection</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- P0.14: BFF — login OIDC do navegador no processo api (client confidencial) e
             sessao no PostgreSQL (core V5). O resource server Bearer continua existindo,
             numa cadeia separada, para apps e integracoes maquina-a-maquina. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <!-- Coordenada certa: o BOM do Boot gerencia spring-session sob
                 org.springframework.session, não org.springframework.boot
                 (essa coordenada não existe e quebrava a leitura do POM). -->
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P0.8: metricas HTTP + Hikari em /actuator/prometheus (Micrometer). O Boot ja
             expoe http.server.requests e hikaricp.* quando o registry esta no classpath;
             sem este starter, /actuator/prometheus nem existe. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- P0.8: traces (Brave) com tenant_id marcado em JwtTenantFilter. Sem o bridge,
             nao ha Tracer no contexto e o span sai sem tenant (o filtro tolera a ausencia). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- P0.10: OpenAPI gerada do código (springdoc, linha 3.x para Spring Boot 4). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- P0.3: ArchUnit disponivel (regras em ArchitectureTest). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- P0.39: version.json GERADO no build (nunca versionado a mao): o template em
             src/main/resources-filtered/version.json recebe project.version (via -Drevision),
             commit abreviado e data do commit (nao o relogio da maquina: dois builds do mesmo
             commit geram o mesmo version.json). O resto dos resources nao e filtrado. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- P0.39: git.properties + propriedades git.* para o version.json e o build-info.
                 Roda em initialize, antes do filtro de resources. Fora de um checkout git,
                 nao falha o build (valores 'unknown' — o CI sempre roda num checkout). -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
                    <dateFormatTimeZone>America/Sao_Paulo</dateFormatTimeZone>
                </configuration>
            </plugin>
            <!-- P0.5: SBOM CycloneDX (target/bom.json), copiado para /app/sbom/bom.json
                 na imagem. Inclui TODAS as dependencias do jar — inclusive os modulos
                 fora do scan de componentes da app (quality, losses, gis, mtr, lgpd,
                 billing, metering, collection), que entram no jar para migrations e
                 entidades JPA. O SBOM lista dependencias; nao afirma que sao beans. -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputFormat>json</outputFormat>
                    <outputName>bom</outputName>
                </configuration>
            </plugin>
            <plugin>
                <!-- Jar executavel (java -jar): so este modulo e a aplicacao. -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- P0.39: build-info.properties (versao/commit/data) para o bean
                         BuildProperties lido pelo VersionHeaderFilter. Fase padrao do goal:
                         generate-resources, antes dos testes. -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>br.com.ziipsan.app.ZiipsanApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
