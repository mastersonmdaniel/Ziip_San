# P0.3: scripts de instalacao de pacotes npm DESABILITADOS. Um pacote comprometido nao
# pode executar codigo arbitrario no install (postinstall/preinstall) na maquina de quem
# roda npm ci nem no CI. Se algum pacote passar a precisar de script de instalacao, a
# falha aparece aqui (build quebrado explicito) e a excecao precisa ser decidida, nao
# assumida em silencio.
ignore-scripts=true
