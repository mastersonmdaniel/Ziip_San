# Copie para .env.local e ajuste. Nenhum segredo vai aqui: variáveis VITE_* são públicas no navegador.

# Base da API (padrão: /api, que o proxy do Vite repassa para http://localhost:8080).
# VITE_API_BASE_URL=/api

# Estilo do mapa (style.json do MapLibre) para o seletor de ponto do imóvel.
# Sem esta variável o mapa NÃO é exibido e só os campos de latitude/longitude funcionam.
# Use um provedor de tiles que você tenha direito de usar; o projeto não embute nenhum.
# VITE_MAP_STYLE_URL=https://exemplo.invalid/style.json
