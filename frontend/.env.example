# Copie para .env.local e ajuste. Nenhum segredo vai aqui: variáveis VITE_* são públicas no navegador.

# Base da API (padrão: /api, que o proxy do Vite repassa para SIGSAN_API_URL).
# VITE_API_BASE_URL=/api

# Destino do proxy /api do servidor de dev (sem prefixo VITE_: não vai para o navegador).
# Padrão: http://localhost:8090 (backend). A 8080 é do Keycloak.
# SIGSAN_API_URL=http://localhost:8090

# Login OIDC (Keycloak, authorization code + PKCE). O client é público: não existe segredo.
# Padrões: realm sigsan do docker-compose e client sigsan-web (infra/keycloak/realms/sigsan-realm.json).
# VITE_OIDC_AUTHORITY=http://localhost:8080/realms/sigsan
# VITE_OIDC_CLIENT_ID=sigsan-web

# Estilo do mapa (style.json do MapLibre) para o seletor de ponto do imóvel.
# Sem esta variável o mapa NÃO é exibido e só os campos de latitude/longitude funcionam.
# Use um provedor de tiles que você tenha direito de usar; o projeto não embute nenhum.
# VITE_MAP_STYLE_URL=https://exemplo.invalid/style.json
