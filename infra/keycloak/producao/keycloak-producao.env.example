# LC.6 — Variáveis de ambiente do Keycloak de produção (AWS) — EXEMPLO
# Produtor: sessão 92031a19-4d6d-4174-92b7-164897d85503 (papel: Produtor)
#
# NENHUM valor real neste arquivo: segredos são referências ao cofre da
# implantação (LC.4 — Secrets Manager) resolvidas no deploy; os demais
# valores derivam do aceite LC.6/P0.29 e do espelho local do compose.
# Não commitar um .env real a partir deste exemplo.

# --- Banco (PostgreSQL do Keycloak; instância/RDS é da LC.3) ---
KC_DB=postgres
# Host/porta/banco do PostgreSQL 17 do Keycloak na AWS: [A DEFINIR] na
# implantação (saída da LC.3). Formato herdado do local:
# jdbc:postgresql://<host>:<porta>/keycloak
KC_DB_URL=[A DEFINIR]
KC_DB_USERNAME=keycloak
# Segredo: referência ao Secrets Manager (LC.4), nunca literal.
KC_DB_PASSWORD=[A DEFINIR — referência de segredo, sem valor]

# --- Partida / build (fixados na imagem; repetidos por clareza) ---
# start --optimized é o CMD da imagem (Dockerfile deste pacote).

# --- Hostname público e TLS (aceite: TLS + sslRequired=all) ---
# Hostname público do IdP na AWS (atrás da borda da LC.2): [A DEFINIR]
KC_HOSTNAME=[A DEFINIR]
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
# TLS termina na borda (LC.2: CloudFront/WAF, TLS 1.3) e/ou no balanceador;
# o canal público é sempre HTTPS. HTTP puro fica desligado no plano público:
KC_HTTP_ENABLED=false
# Quando o TLS terminar no próprio Keycloak (alternativa à borda), os
# arquivos abaixo são montados do segredo de certificado (LC.4):
KC_HTTPS_PORT=8443
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/certs/tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/certs/tls.key
# Atrás de proxy/borda, cabeçalhos encaminhados (equivalente do Keycloak 26
# ao antigo KC_PROXY, conforme comentário do compose local):
KC_PROXY_HEADERS=xforwarded

# --- Sessão / cluster (aceite: 2 réplicas sem perda de sessão) ---
# Mesmo mecanismo provado localmente (compose, perfil ha): cache
# distribuído Infinispan com descoberta pelo banco (jdbc-ping) sobre o
# PostgreSQL compartilhado — a sessão sobrevive à derrubada de 1 réplica.
KC_CACHE=ispn
KC_CACHE_STACK=jdbc-ping

# --- Saúde/observabilidade (consumido pela LC.7) ---
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true

# --- Administração ---
# Conta administrativa de bootstrap NÃO é criada com senha em arquivo:
# o acesso administrativo de produção é [A DEFINIR] no procedimento de
# implantação (cofre LC.4 + MFA), pendência P-LC6-05.
KC_BOOTSTRAP_ADMIN_USERNAME=[A DEFINIR]
KC_BOOTSTRAP_ADMIN_PASSWORD=[A DEFINIR — referência de segredo, sem valor]
