# Pacote LC.15 — Produtor, sessao b3a03bf9-b502-478f-a071-9590cb482d99
# Configuracao do backend (usar: terraform init -backend-config=backend.hcl)
# O bucket vive NA CONTA DEDICADA do cliente (conta separada do aceite),
# em sa-east-1 — nao no bucket de state da producao compartilhada.
# bucket         = "[A DEFINIR: bucket de state da conta DEDICADA, em sa-east-1]"
# key            = "ziipsan/dedicado/terraform.tfstate"
# region         = "sa-east-1"
# encrypt        = true
# use_lockfile   = true
# kms_key_id     = "[A DEFINIR: chave KMS do state (LC.4), na conta dedicada]"
# Regras do state (aceite LC.2/LC.15: sem segredo no state):
# - versionamento ligado, Object Lock conforme LC.5, acesso publico bloqueado;
# - o state guarda apenas IDs/ARNs/atributos — esta IaC nao recebe segredo;
# - acesso ao bucket restrito ao papel do pipeline do ambiente dedicado.
