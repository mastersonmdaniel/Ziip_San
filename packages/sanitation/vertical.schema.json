{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziipsan.local/schemas/vertical.schema.json",
  "title": "Manifesto de pacote de vertical (P0.47)",
  "type": "object",
  "required": [
    "id",
    "version",
    "minPlatformVersion",
    "nameKey",
    "descriptionKey",
    "modules",
    "gis"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "minPlatformVersion": {
      "type": "string"
    },
    "nameKey": {
      "type": "string"
    },
    "descriptionKey": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mavenModule",
          "status",
          "originTask",
          "menu",
          "apiRoutes",
          "unitSheetTabs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "mavenModule": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "declared",
              "skeleton"
            ]
          },
          "originTask": {
            "type": "string"
          },
          "permission": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z]+:[a-z-]+$"
          },
          "engine": {
            "type": "string",
            "enum": [
              "core"
            ]
          },
          "menu": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "route",
                "icon"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "route": {
                  "type": "string",
                  "pattern": "^/"
                },
                "icon": {
                  "type": "string"
                },
                "permission": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z]+:[a-z-]+$"
                }
              }
            }
          },
          "apiRoutes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "unitSheetTabs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gis": {
      "type": "object",
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "color",
              "order"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              },
              "label": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^map-[a-z]+$"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "catalogNote": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "type": "array"
    },
    "onboarding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "title"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+:[a-z-]+$"
      }
    },
    "factoryProfiles": {
      "type": "array",
      "description": "Perfis de fábrica da P1.37, espelhados de PermissionCatalog.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "homePage",
          "enabled",
          "permissions"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "maxLength": 20
          },
          "label": {
            "type": "string"
          },
          "homePage": {
            "type": "string",
            "pattern": "^/"
          },
          "enabled": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+:[a-z-]+$"
            }
          }
        }
      }
    },
    "serviceTypes": {
      "type": "array",
      "description": "Tipos de servico declarados pelo pacote (P1.31, mapa 23b §3.2).",
      "items": {
        "type": "object",
        "required": [
          "code",
          "approvalByAnotherPerson",
          "effectValidity",
          "targetClasses",
          "effectCode",
          "declarableNow",
          "originTask"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "approvalByAnotherPerson": {
            "type": "boolean"
          },
          "effectValidity": {
            "type": "string"
          },
          "targetClasses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effectCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "declarableNow": {
            "type": "boolean"
          },
          "originTask": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "serviceTypesNote": {
      "type": "string"
    },
    "operationalTypes": {
      "type": "object",
      "properties": {
        "enabledBy": {
          "type": "string"
        },
        "deadlineBy": {
          "type": "string"
        },
        "effectCode": {
          "type": "null"
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "serviceOrderTargets": {
      "type": "array",
      "description": "Classes de alvo da OS com fonte da verdade e status do verificador (P1.31).",
      "items": {
        "type": "object",
        "required": [
          "class",
          "sourceOfTruth",
          "verifier"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "sourceOfTruth": {
            "type": "string"
          },
          "verifier": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Catálogo único de eventos de negócio (P1.38, ADR-0037). A carga (payloadSchema) carrega só identificadores e códigos, sem dado pessoal.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "description",
          "payloadSchema",
          "requiredPermission",
          "consumers",
          "originTask"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "payloadSchema": {
            "type": "object"
          },
          "requiredPermission": {
            "type": "string",
            "pattern": "^[a-z]+:[a-z-]+$"
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "originTask": {
            "type": "string"
          }
        }
      }
    },
    "eventsNote": {
      "type": "string"
    },
    "declaredEventConsumers": {
      "type": "array",
      "description": "Consumidores declarados no catálogo (P1.38): só declarados, não construídos.",
      "items": {
        "type": "object",
        "required": [
          "task",
          "name"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "eventGaps": {
      "type": "array",
      "description": "Tipos que aparecem no código mas NÃO são eventos declarados (lacunas a resolver antes de qualquer publicação).",
      "items": {
        "type": "object",
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "modules": {
          "contains": {
            "properties": {
              "id": {
                "const": "certification"
              },
              "engine": {
                "const": "core"
              }
            },
            "required": [
              "id",
              "engine"
            ]
          }
        }
      },
      "required": [
        "modules"
      ]
    }
  ]
}
