{"$schema": "./vertical.schema.json", "descriptionKey": "vertical.sanitation.description", "gis": {"catalogNote": "Domínios declarados, não carregados: a tabela gis_domain e a carga do catálogo de fábrica chegam na P1.26 (V13_1). Até lá este bloco é a declaração, não o dado.", "domains": [{"color": "map-water", "key": "WATER", "label": "Água", "order": 1}, {"color": "map-sewer", "key": "SEWER", "label": "Esgoto", "order": 2}, {"color": "map-storm", "key": "STORM", "label": "Drenagem", "order": 3}, {"color": "map-waste", "key": "WASTE", "label": "Resíduos", "order": 4}, {"color": "map-context", "key": "CONTEXT", "label": "Contexto", "order": 5}]}, "help": "docs/arquitetura/PLATAFORMA-E-VERTICAIS.md", "id": "sanitation", "migrations": {"core": ["V6_1"], "tenant": "faixas existentes por módulo (registry V3_x, billing V4_x, metering V5_x, collection V6_x)"}, "minPlatformVersion": "1.0.0-SNAPSHOT", "modules": [{"apiRoutes": ["/api/v1/registry/consumer-units", "/api/v1/registry/customers", "/api/v1/registry/categories", "/api/v1/registry/subcategories", "/api/v1/registry/water-statuses", "/api/v1/registry/sewer-statuses", "/api/v1/registry/holder-situations"], "id": "registry", "mavenModule": "commercial/ziipsan-registry", "menu": [{"icon": "building", "label": "Imóveis", "permission": "registry:read", "route": "/cadastro/imoveis"}, {"icon": "users", "label": "Clientes", "permission": "registry:read", "route": "/cadastro/clientes"}, {"icon": "map", "label": "Hierarquia territorial", "permission": "registry:read", "route": "/cadastro/territorio"}, {"icon": "list-checks", "label": "Catálogos", "permission": "registry:read", "route": "/cadastro/catalogos"}], "name": "Cadastro comercial", "originTask": "P0.13/P0.16", "permission": "registry:read", "status": "active", "unitSheetTabs": []}, {"apiRoutes": [], "id": "service-order", "mavenModule": "shared/ziipsan-core", "menu": [], "name": "Ordens de serviço", "originTask": "P1.31", "permission": null, "status": "declared", "unit