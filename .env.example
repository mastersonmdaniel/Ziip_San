# Copie para .env (que nao e versionado) e preencha. Sem estes valores o docker compose recusa subir:
# nao existe senha padrao.
#
# Gere senhas fortes, por exemplo:  openssl rand -base64 24

# PostgreSQL: superusuario de bootstrap (so init e operacao; a aplicacao nunca usa)
POSTGRES_SUPERUSER_PASSWORD=
# Role da aplicacao (ziipsan_app) e role de migracao (ziipsan_migrator)
ZIIPSAN_APP_PASSWORD=
ZIIPSAN_MIGRATOR_PASSWORD=
# P2.2 (pools por papel, opcionais): senhas das roles ziipsan_batch e
# ziipsan_ingest. As roles nascem NOLOGIN no init de seguranca; LOGIN +
# senha sao concedidos pelo deploy (ou pelo roteiro de IT). Sem estas
# variaveis, o PgBouncer nao autentica os dois papeis e a aplicacao com
# ziipsan.db.pools.enabled=true falha rapido sem a senha do papel.
# ZIIPSAN_BATCH_PASSWORD=
# ZIIPSAN_INGEST_PASSWORD=
# Banco e role proprios do Keycloak
KEYCLOAK_DB_PASSWORD=
# Admin de bootstrap do Keycloak (usuario "admin"; console em http://localhost:8080/admin)
KEYCLOAK_ADMIN_PASSWORD=

# Opcional: pasta local com o realm do Keycloak (infra/keycloak/realms) quando o fonte esta num
# disco que o Docker nao enxerga (ex.: G: do Google Drive).
# ZIIPSAN_KC_IMPORT_DIR=

# Aplicacao (scripts/run-app.sh): chave mestra de DESENVOLVIMENTO para a cifra de CPF/CNPJ (32 bytes
# em Base64, ex.: openssl rand -base64 32). Nunca usar em producao (la a chave vem do Vault).
ZIIPSAN_DEV_MASTER_KEY=

# Tenant de desenvolvimento (perfil local): provisionado na subida se nao existir. O mesmo UUID vai
# no atributo tenant_id do usuario criado por scripts/kc-dev-user.sh.
ZIIPSAN_DEV_TENANT_ID=
ZIIPSAN_DEV_TENANT_SCHEMA=dev_local

# BFF (P0.14): segredo do client confidencial ziipsan-bff no Keycloak. O client entra
# no realm sem segredo no JSON (nunca versionado): ao importar o realm, o Keycloak gera
# o segredo — copie-o do console para aqui (ou para o cofre, em producao). Sem este
# valor a api nao sobe.
ZIIPSAN_BFF_CLIENT_SECRET=

# P0.27/P0.29 (ambiente local): token do cofre local (Vault) e senha do emulador
# de S3 (SeaweedFS, perfil storage). Sem estes valores os perfis que os usam
# recusam subir. Nunca versionar valores reais.
# VAULT_TOKEN=
# MINIO_PASSWORD=

# P0.27 (homolog/demo): imagem da aplicacao (scripts/build-image.sh) e, para o
# rollback, a imagem anterior. Sem ZIIPSAN_APP_IMAGE, local-env.sh sobe so a infra.
# ZIIPSAN_APP_IMAGE=
# ZIIPSAN_APP_IMAGE_PREVIOUS=
