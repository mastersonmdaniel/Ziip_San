<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.ziipsan</groupId>
    <artifactId>ziipsan</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>ZIIPSAN - Sistema Integrado de Gestão de Saneamento</name>
    <description>SaaS vertical multi-tenant para saneamento (agua/esgoto/residuos)</description>

    <properties>
        <!-- P0.39: versao gerada pela tag e injetada por -Drevision (scripts/version-from-tag.sh).
             Sem -Drevision, o padrao abaixo vale (build local/dev). NUNCA escreva uma versao
             de release a mao aqui: o CI (check-no-hardcoded-version.py) barra versao literal
             de release nos poms. -->
        <revision>0.0.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <spring.boot.version>4.1.1</spring.boot.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <lombok.version>1.18.46</lombok.version>
        <jts.version>1.19.0</jts.version>
        <twelvemonkeys.version>3.15.3</twelvemonkeys.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Versão única: antes conviviam 1.18.2 e 1.19.0. 1.19.0 é a que o geolatte-geom 1.11
                     (via hibernate-spatial 7.4) declara. -->
                <groupId>org.locationtech.jts</groupId>
                <artifactId>jts-core</artifactId>
                <version>${jts.version}</version>
            </dependency>
            <dependency>
                <!-- P1.19: leitor WebP (só leitura) do TwelveMonkeys para o reencode
                     do logo do tenant. O JDK não decodifica WebP; sem este leitor, um
                     logo WebP não poderia ser reencodado — só validado por estrutura.
                     Licença BSD-3-Clause, na lista permitida (third-party-licenses-allowed.json).
                     A escrita é sempre PNG pelo ImageIO do JDK (logo canônico, sem
                     metadados do original); o WebP de entrada vira PNG na saída. -->
                <groupId>com.twelvemonkeys.imageio</groupId>
                <artifactId>imageio-webp</artifactId>
                <version>${twelvemonkeys.version}</version>
            </dependency>
            <!-- fix(build): Tomcat embarcado 11.0.27, acima do gerenciado pelo Boot 4.1.1
                 (11.0.24). 11.0.24 acumula 9 achados CVSS >= 7 no OWASP (lote 2026-08-25,
                 corrigido em 11.0.25: CVE-2026-65182, 65183, 65637, 65905, 65927, 66422,
                 68525, 68569). 11.0.27 e a versao 11.0.x mais recente no Central e cobre
                 tambem os lotes seguintes (11.0.26, 2026-09-15; 11.0.27, 2026-10-12).
                 O 9o achado listado (CVE-2026-66873) nao tem registro publico (NVD e
                 CVE.org: inexistente em 2026-11-01), logo nenhuma versao de fix pode ser
                 atribuida a ele — a versao mais recente da linha 11.0.x e a escolha
                 defensavel, sem subir o Boot.
                 POR QUE ENTRADA EXPLICITA E NAO PROPERTY: o projeto importa
                 spring-boot-dependencies via scope=import (nao usa parent). Verificado
                 neste build: <tomcat.version>11.0.27</tomcat.version> no properties
                 avalia para 11.0.27, mas a arvore continua resolvendo 11.0.24 — o
                 dependencyManagement importado e interpolado com as properties do
                 proprio BOM. Entradas explicitas no dependencyManagement do projeto
                 tem precedencia sobre as importadas. Remover quando o Boot gerenciar
                 >= 11.0.27. Nao suprimir, nao baixar o limiar CVSS, nao excluir do scan. -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>11.0.27</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>11.0.27</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>11.0.27</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>shared/ziipsan-core</module>
        <module>shared/ziipsan-security</module>
        <module>platform/ziipsan-platform</module>
        <module>intelligence/ziipsan-losses</module>
        <module>intelligence/ziipsan-quality</module>
        <module>intelligence/ziipsan-gis</module>
        <module>intelligence/ziipsan-reporting</module> <!-- P3.22 -->
        <module>grs/ziipsan-mtr</module>
        <module>compliance/ziipsan-lgpd</module>
        <module>commercial/ziipsan-registry</module>
        <module>commercial/ziipsan-billing</module>
        <module>operations/ziipsan-metering</module>
        <module>operations/ziipsan-asset</module>
        <module>commercial/ziipsan-collection</module>
        <module>commercial/ziipsan-fiscal</module>
        <module>integration/ziipsan-integration</module>
        <module>platform/ziipsan-app</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                    <configuration>
                        <layers>
                            <enabled>true</enabled>
                        </layers>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.16</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- P0.39: flatten resolve ${revision} no pom instalado/publicado, sem tocar
                 no pom-fonte. Sem ele, um install/deploy publicaria a versao literal
                 "${revision}" e quebraria quem depende do artefato (e o CycloneDX, que
                 resolve o parent a partir do pom, ficaria procurando ${revision} nos
                 repositorios remotos). updatePomFile=true e OBRIGATORIO aqui: o default
                 do plugin so substitui o pom em projetos com packaging != pom — e o root
                 e packaging pom, logo sem este flag o pom instalado continuava literal. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- P0.3: enforcer ATIVO (antes, so em pluginManagement, nao executava nada).
                 Java 21 e Maven >= 3.8 em todos os modulos; sem ele, um build com Java
                 errado so falharia depois, com erro obscuro. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.8,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- P0.3: JaCoCo SEM meta inicial (so mede e relata; o teto de cobertura
                 vem depois, quando houver linha de base estavel — ver plano). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>