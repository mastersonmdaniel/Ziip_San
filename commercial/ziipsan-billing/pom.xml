<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.ziipsan</groupId>
        <artifactId>ziipsan</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ziipsan-billing</artifactId>
    <name>ZIIPSAN Billing - Tarifa, conta e ciclo de faturamento</name>
    <description>Motor de tarifa (vigencia, faixas, categoria), calculo da conta, creditos e debitos, acrescimos por impontualidade.</description>

    <dependencies>
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- P2.5 (F2): o snapshot do titular faturado (DAD-15) e cifrado com o
             FieldCipher do ziipsan-security; sem esta dependencia o billing nao
             compila o BillSnapshotService. -->
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- P2.17 (correcao da revisao cruzada): o teste
             BrandedBillTemplateContentTest importa as classes de modelo/marca
             de ziipsan-platform (TemplateBlock, LegalTemplateBlocks,
             BrandedDocumentComposer, BrandedTemplateGuard, TenantPdfBrand).
             O pom vigente no repo NAO declara esta dependencia — sem ela o
             teste nao compila. Escopo test: nenhum codigo de producao do
             billing usa platform hoje. -->
        <dependency>
            <groupId>br.com.ziipsan</groupId>
            <artifactId>ziipsan-platform</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
