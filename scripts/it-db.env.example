# Modelo LOCAL (copie para scripts/it-db.env, que NAO e versionado desde a P0.3).
# Senhas SO do PostgreSQL descartavel de integracao (scripts/reset-it-db.sh, porta 55433).
# O banco existe apenas durante o build e nao guarda dado real. Nao reutilizar em nenhum
# outro ambiente: desenvolvimento e producao leem as senhas de .env / Secret, sem valor padrao.
# Gere valores proprios, por exemplo: openssl rand -hex 16
# (nunca commitar o arquivo preenchido).
ZIIPSAN_IT_SUPERUSER_PASSWORD=
ZIIPSAN_IT_DB_PASSWORD=
ZIIPSAN_IT_MIGRATOR_PASSWORD=
# P2.2: senhas dos pools por papel nos ITs (roles ziipsan_batch /
# ziipsan_ingest, com LOGIN concedido pelo roteiro de IT).
# ZIIPSAN_IT_BATCH_PASSWORD=
# ZIIPSAN_IT_INGEST_PASSWORD=
