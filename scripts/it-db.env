# Senhas SO do PostgreSQL descartavel de integracao (scripts/reset-it-db.sh, porta 55433).
# O banco existe apenas durante o build e nao guarda dado real. Nao reutilizar em nenhum outro
# ambiente: desenvolvimento e producao leem as senhas de .env / Secret, sem valor padrao.
#
# Os testes (TenantRlsIsolationTest, TenantProvisioningServiceTest, ProvisionedTenant) usam estes
# mesmos valores como padrao de SIGSAN_IT_DB_PASSWORD e SIGSAN_IT_MIGRATOR_PASSWORD.
SIGSAN_IT_SUPERUSER_PASSWORD=it_superuser_password
SIGSAN_IT_DB_PASSWORD=sigsan_dev_password
SIGSAN_IT_MIGRATOR_PASSWORD=sigsan_migrator_password
