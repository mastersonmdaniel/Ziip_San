# P2.9 -- Capacidade do Keycloak medida na P0.23 (PLT-28): TRANSCREVA aqui os
# numeros do registro da P0.23 antes de rodar a carga.
#
# PENDENCIA DECLARADA: nos espelhos locais consultados e no trecho do repo
# alcancado antes do HTTP 429 NAO ha artefato nem resultado da P0.23 (nem o
# dimensionamento da ARQUITETURA-ALVO sec.6, nem a meta de pico do portal).
# Sem estes numeros, o checar-keycloak.sh FALHA FECHADO: ele nao inventa
# capacidade. Onde procurar no PC do dono: o registro da execucao da P0.23
# (relatorio/serie temporal da carga inicial com o kit de benchmark oficial
# do Keycloak -- logins, renovacoes e client_credentials -- e a medicao do
# autenticador do portal sobre a base sintetica de 1 milhao de usuarios).
KC_PORTAL_PEAK_RPS=          # meta de pico do portal registrada na P0.23 (req/s)
KC_LOGIN_P95_MAX_MS=         # p95 de login medido/limite da P0.23 (ms)
KC_MAX_ERROR_RATE=           # taxa de erro maxima aceita no cenario da P0.23 (0..1)
P95_BASELINE_MS=             # p95 da API na carga de referencia da P0.23 (ms);
                             # a sonda reprova se o p95 atual passar de
                             # baseline * 1.15 (regressao RNF-70). Movido de
                             # carga.env para ca: e numero da P0.23.
# KC_PORTAL_USERS_BASE (base sintetica de usuarios do realm na P0.23) SAIU
# deste example na correcao pos-revisao: nenhuma peca do aparato o lia --
# era numero transcrito sem uso. Se o cenario completo da PLT-28 for
# implementado, ele volta junto da peca que o consumir.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_PORTAL_REALM=       # nome do realm do portal (o realm da API e "ziipsan", verificado no compose)
# KC_ADMIN_USER / KC_ADMIN_PASSWORD: do ambiente (.env local), nunca aqui.
