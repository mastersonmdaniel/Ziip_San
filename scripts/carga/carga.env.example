# P2.9 -- Parametros da carga. Copie para carga.env (NAO versionado, como o
# it-db.env da P0.3) e ajuste. Senhas NUNCA aqui em claro no git: use o
# ambiente ou o it-db.env existente.
CARGA_TENANT_ID=            # UUID do tenant DESCARTAVEL da carga (nunca producao)
CARGA_SEMENTE=ziipsan-carga-p29-v1
CARGA_LIGACOES=300000       # aceite P2.9
CARGA_FATURAR=100000        # aceite P2.9 (subconjunto faturado)
CARGA_REFERENCE_MONTH=2026-10-01
CARGA_LIMITE_SEG=7200       # aceite P2.9: 100 mil contas em menos de 2 h
# Banco do ambiente de homologacao local (perfil homolog da P0.27), via psql:
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ziipsan
PGUSER=ziipsan_migrator     # dono das tabelas no schema do tenant
# PGPASSWORD vem do ambiente/it-db.env -- nao escreva aqui.
# API sob medicao (paralela a carga):
API_BASE_URL=http://127.0.0.1:8090
API_PROBE_PATHS=/actuator/health
# API_BEARER_TOKEN=         # do ambiente, se o caminho sondado exigir auth
# Teto do p95 (criterio do teto): preencha se o projeto definir o numero.
# O OUTRO criterio -- a linha de base da P0.23 com a regressao de +15%
# (RNF-70) -- mora em carga-p0.23.env (P95_BASELINE_MS), porque e numero
# DA P0.23: ponto unico de transcricao de cada origem.
P95_MAX_MS=                 # teto numerico do RNF, se o projeto o definir
# Disparo do faturamento: comando que comanda a atividade BILLING do ciclo
# para a referencia (P2.5: CycleService -> CycleBatchGateway -> fundacao de
# lote da P2.1). A fiacao desse disparo no app e o pacote M7 da integracao
# p2b; enquanto ela nao pousar, NAO ha comando real para colocar aqui e o
# orquestrador PARA (falha fechada) em vez de fingir faturamento.
# Exemplo do formato esperado quando o M7 pousar (endpoint/CLI reais):
# BILLING_TRIGGER_CMD='curl -fsS -X POST "$API_BASE_URL/api/..." -H "Authorization: Bearer $API_BEARER_TOKEN"'
BILLING_TRIGGER_CMD=
# Espera ativa: comando que sai 0 quando o lote terminou (ex.: consulta ao
# job_runs da fundacao). Sem ele, o orquestrador espera CARGA_LIMITE_SEG e
# confere as contas pela verificacao SQL (90-verificacao.sql).
BILLING_DONE_CMD=
