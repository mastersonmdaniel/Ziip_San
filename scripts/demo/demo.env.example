# P3.23 -- Configuracao do ambiente de DEMONSTRACAO local.
# Copie para demo.env (NAO versionado com valores reais de tenant) e preencha.
# As senhas continuam no .env da raiz (P0.27); aqui so vai o que e da demo.

# Tenant de demonstracao: UUID PROPRIO, diferente do tenant de
# desenvolvimento (ZIIPSAN_DEV_TENANT_ID do .env) e de qualquer tenant de
# homologacao. O recriar-demo.sh RECUSA igualdade -- demonstracao separada
# da homologacao e item de aceite, nao convencao.
DEMO_TENANT_ID=

# Schema do tenant de demonstracao (search_path das sementes). Precisa ser
# o schema DESTE tenant e diferente do schema de homologacao/desenvolvimento.
DEMO_TENANT_SCHEMA=demo_poc

# Unidades da massa: o aceite exige PELO MENOS 10.000; o gerador recusa
# menos. Padrao 12000 (folga declarada, nao numero do aceite).
DEMO_UNIDADES=12000

# Semente da massa sintetica (determinismo: mesma semente, mesma massa).
DEMO_SEMENTE=ziipsan-demo-p323-v1

# Referencia (mes de faturamento) que a demonstracao usa nas sementes de
# medicao/tarifa herdadas da P2.9. AAAA-MM-01.
DEMO_REFERENCE_MONTH=2026-10-01

# Guarda fiscal (P0.27): em perfil local isto e SEMPRE false. O
# recriar-demo.sh falha se encontrar true em qualquer um dos dois lugares.
# ZIIPSAN_FISCAL_PRODUCTION_ALLOWED=false
